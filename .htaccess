Options -Indexes
DirectoryIndex dist/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.corpad\.com\.br$ [NC]
  RewriteRule ^ https://corpad.com.br%{REQUEST_URI} [R=301,L]

  RewriteRule ^dist/ - [L]

  RewriteRule ^blog-api\.php$ dist/blog-api.php [L,QSA]
  RewriteRule ^blog-post\.php$ dist/blog-post.php [L,QSA]
  RewriteRule ^blog-index\.php$ dist/blog-index.php [L,QSA]
  RewriteRule ^sitemap\.php$ dist/sitemap.php [L,QSA]
  RewriteRule ^sitemap\.xml$ dist/sitemap.php [L]
  RewriteRule ^blog/?$ dist/blog-index.php [L]
  RewriteRule ^blog/([^/]+)/?$ dist/blog-post.php?slug=$1 [L,QSA]

  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.+)$ dist/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.+?)/?$ dist/$1/ [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/$1/index.html -f
  RewriteRule ^(.+?)/?$ dist/$1/index.html [L]

  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^ dist/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
