{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/api/page/home"
    },
    {
      "source": "/corpad-digital",
      "destination": "/api/page/corpad-digital"
    },
    {
      "source": "/corpad-consultoria",
      "destination": "/api/page/corpad-consultoria"
    },
    {
      "source": "/portfolio",
      "destination": "/api/page/portfolio"
    },
    {
      "source": "/clientes",
      "destination": "/api/page/clientes"
    },
    {
      "source": "/blog",
      "destination": "/api/page/blog"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/api/page/termos-de-uso"
    },
    {
      "source": "/criacao-de-sites-monte-alto",
      "destination": "/api/local/criacao-de-sites-monte-alto"
    },
    {
      "source": "/criacao-de-sites-ribeirao-preto",
      "destination": "/api/local/criacao-de-sites-ribeirao-preto"
    },
    {
      "source": "/marketing-digital-ribeirao-preto",
      "destination": "/api/local/marketing-digital-ribeirao-preto"
    },
    {
      "source": "/trafego-pago-ribeirao-preto",
      "destination": "/api/local/trafego-pago-ribeirao-preto"
    },
    {
      "source": "/consultoria-empresarial-monte-alto",
      "destination": "/api/local/consultoria-empresarial-monte-alto"
    },
    {
      "source": "/consultoria-empresarial-ribeirao-preto",
      "destination": "/api/local/consultoria-empresarial-ribeirao-preto"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/:slug"
    },
    {
      "source": "/corpad-consultoria/servicos/:slug",
      "destination": "/api/consulting-service/:slug"
    },
    {
      "source": "/servicos/:slug",
      "destination": "/api/service/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
